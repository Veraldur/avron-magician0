{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avron: Magician",
  "version": "1.0.0",
  "identifier": "com.veraldur.avronmagician",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Avron: Magician",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
